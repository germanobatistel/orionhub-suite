{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python scripts/check_release.py",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{frontend/**,backend/**,api/**}",
      "excludeFiles": "{backend/test_*,tests/**,**/__pycache__/**,**/*.sqlite3,**/*.log}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "framework": null
}
